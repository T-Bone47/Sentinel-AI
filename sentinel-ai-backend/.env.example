# Copy to .env and adjust for your environment. Never commit the real .env.

APP_NAME="Sentinel AI"
ENVIRONMENT=development
DEBUG=false

# Async URL (asyncpg) used by the running app
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel_ai
# Sync URL (psycopg) used by Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel_ai

# Generate a real value for anything beyond local dev, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7


UPLOADS_DIR=/mnt/user-data/uploads

# NVIDIA NIM Copilot (optional - Copilot falls back to deterministic without these)
# Get a key from https://build.nvidia.com. Keep server-side only.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.3-flash
NVIDIA_TIMEOUT_SECONDS=120
NVIDIA_MAX_TOKENS=1200
NVIDIA_TEMPERATURE=0.2

COPILOT_LLM_ENABLED=false
COPILOT_LLM_PROVIDER=nvidia
COPILOT_LLM_FALLBACK_ENABLED=true

# Legacy generic LLM settings (used only if NVIDIA_API_KEY is empty)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=15